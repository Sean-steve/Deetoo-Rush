{
  "name": "deetoo",
  "private": true,
  "version": "1.0.0",
  "description": "Deetoo Multi-Vendor Food Delivery Platform - Monorepo",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:api": "tsx --import dotenv/config server.ts",
    "dev:harness": "tsx --import dotenv/config dev-harness.ts",
    "dev:customer": "vite --config apps/customer-web/vite.config.ts",
    "dev:merchant": "vite --config apps/merchant-web/vite.config.ts",
    "dev:admin": "vite --config apps/admin-web/vite.config.ts",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "pnpm build:customer && pnpm build:merchant && pnpm build:admin",
    "build:customer": "vite build --config apps/customer-web/vite.config.ts",
    "build:merchant": "vite build --config apps/merchant-web/vite.config.ts",
    "build:admin": "vite build --config apps/admin-web/vite.config.ts",
    "build:api": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/api/server.cjs",
    "start": "node --import dotenv/config dist/api/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test DEETOO_STORAGE_MODE=memory DEETOO_FIXTURES=true tsx --test tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:unit": "NODE_ENV=test DEETOO_STORAGE_MODE=memory DEETOO_FIXTURES=true tsx --test tests/unit/**/*.test.ts",
    "test:integration": "NODE_ENV=test DEETOO_STORAGE_MODE=memory DEETOO_FIXTURES=true tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "NODE_ENV=test DEETOO_STORAGE_MODE=memory DEETOO_FIXTURES=true tsx --test tests/e2e/**/*.test.ts",
    "test:phase1-browser": "playwright test --config playwright.phase1.config.ts",
    "format": "echo 'All files verified'",
    "db:migrate": "tsx --import dotenv/config scripts/db-migrate.ts",
    "db:migrate:dev": "tsx --import dotenv/config scripts/db-migrate.ts --dev",
    "db:rollback": "tsx --import dotenv/config scripts/db-rollback.ts",
    "db:seed": "tsx --import dotenv/config scripts/db-seed.ts",
    "governance:bootstrap-super-admin": "tsx --import dotenv/config scripts/bootstrap-super-admin.ts",
    "dev:demo": "DEETOO_STORAGE_MODE=memory DEETOO_FIXTURES=true tsx --import dotenv/config dev-harness.ts",
    "worker:outbox": "tsx --import dotenv/config scripts/outbox-worker.ts",
    "test:foundation": "NODE_ENV=test DEETOO_STORAGE_MODE=postgres DEETOO_FIXTURES=false tsx --test tests/foundation/*.test.ts",
    "worker:payments": "tsx --import dotenv/config scripts/payment-worker.ts",
    "payment:doctor": "tsx --import dotenv/config scripts/payment-doctor.ts",
    "worker:dispatch": "tsx --import dotenv/config scripts/dispatch-worker.ts",
    "dispatch:doctor": "tsx --import dotenv/config scripts/dispatch-doctor.ts",
    "openapi:coverage": "tsx scripts/openapi-coverage-check.ts",
    "openapi:validate": "tsx scripts/openapi-validate.ts",
    "test:paid-order": "NODE_ENV=test DEETOO_STORAGE_MODE=postgres DEETOO_FIXTURES=false tsx --test tests/paid-order/*.test.ts",
    "test:local-workflow": "NODE_ENV=test DEETOO_STORAGE_MODE=postgres DEETOO_FIXTURES=false tsx --test tests/local-workflow/*.test.ts",
    "typecheck:rider-android": "pnpm --filter @deetoo/rider-android typecheck",
    "build:rider-android": "pnpm --filter @deetoo/rider-android export:android",
    "worker:notifications": "tsx --import dotenv/config scripts/notification-worker.ts",
    "worker:automation": "tsx --import dotenv/config scripts/automation-worker.ts",
    "workers:start": "tsx --import dotenv/config scripts/worker-supervisor.ts",
    "test:phase2": "NODE_ENV=test DEETOO_STORAGE_MODE=memory DEETOO_FIXTURES=true tsx --test tests/unit/phase2_native_fulfilment.test.ts",
    "prebuild:rider-android": "pnpm --filter @deetoo/rider-android prebuild:android",
    "test:phase3": "NODE_ENV=test DEETOO_STORAGE_MODE=memory DEETOO_FIXTURES=true tsx --test tests/unit/phase3_operations_moneyout.test.ts tests/unit/phase3_trust_rider_wallet.test.ts",
    "test:merchant-staging": "tsx scripts/merchant-staging-release-gate.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.5.4",
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
