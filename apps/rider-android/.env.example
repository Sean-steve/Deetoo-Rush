# Copy this to apps/rider-android/.env (do not commit your actual key).
# A MapTiler client-visible key is needed for streets basemap tiles.
# Restrict this key for DeeToo's Android use in the provider dashboard.
EXPO_PUBLIC_RIDER_MAPTILER_KEY=

# Alternatively: authorized HTTPS XYZ raster template (with {z}, {x}, {y}).
# EXPO_PUBLIC_RIDER_TILE_TEMPLATE=https://your-tiles.example/{z}/{x}/{y}.png

# Keep your existing EXPO_PUBLIC_API_BASE_URL used by Rider login.
# For physical phones use a LAN-reachable API configured securely.
