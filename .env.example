# Deetoo Platform Configuration Baseline

# Database Configuration (PostgreSQL 16 + PostGIS)
# Use the same local password in both settings; URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL="postgres://postgres:replace_with_local_password@127.0.0.1:5433/deetoo_dev"
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000

# Cache & Ephemeral State (Redis 7)
REDIS_URL="redis://localhost:6379"

# Application Environment & Logging
APP_ENV="development"
LOG_LEVEL="info"
PORT=3000
API_BASE_URL="http://localhost:3000/api/v1"

# Security & Identity
JWT_SECRET="deetoo_dev_jwt_secret_change_in_production_min_32_chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Exact browser origins allowed by API CORS/origin checks. No wildcard or suffix matching.
# Production web deployments should reverse-proxy /api/v1 to the central API so auth
# cookies remain host-only to each application domain.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Payment Provider Configuration (Future Sprint 2/7 placeholders - non-functional in Sprint 1)
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY="mpesa_sandbox_consumer_key"
MPESA_CONSUMER_SECRET="mpesa_sandbox_consumer_secret"
MPESA_PASSKEY="mpesa_sandbox_passkey"
MPESA_BUSINESS_SHORT_CODE="174379"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL is authoritative by default. Memory is an explicit local fixture adapter only.
DEETOO_STORAGE_MODE=postgres
DEETOO_FIXTURES=false
# Use `pnpm dev:demo` for isolated UI fixtures. Never use this adapter in staging/production.
# Run `pnpm worker:outbox` as a separate supervised process with the same DATABASE_URL.
# Staging/production require explicit DATABASE_URL, REDIS_URL and JWT_SECRET (32+ characters).

# Separate 32-byte base64 key for encrypted authenticator credentials; inject through the deployment secret store.
# Do not reuse JWT_SECRET. Missing configuration blocks enrollment/verification.
MFA_ENCRYPTION_KEY=

# Wave 2: run `pnpm worker:payments` separately with the same PostgreSQL database.
# Card uses verified Stripe intents, raw-body signatures and receiver identity.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
# Daraja requires an explicitly selected environment and authenticated callback gateway.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_WEBHOOK_SECRET=
# M-PESA transaction evidence and reversal certification remain fail-closed until configured.
# Wave 2: Transaction Status Query / Reversal authoritative evidence (ADR-007).
# Initiator name and its encrypted Security Credential come from the Daraja org security
# credential portal, NOT the consumer key/secret pair above. Result/Timeout URLs must be
# HTTPS and reachable by Safaricom; they receive the asynchronous command outcome.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_RESULT_URL=
MPESA_TIMEOUT_URL=

# Operating Phase 2: account recovery (configure real verified senders)
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AUTH_SMS_FROM=

# Card checkout return page (HTTPS required in production)
PAYMENT_RETURN_URL=

# Local PostgreSQL workflow only; rejected in staging/production. No real funds.
DEETOO_LOCAL_WORKFLOW=false

# Phase 2 — Rider Android push notifications (Firebase Cloud Messaging HTTP v1)
# FCM_PRIVATE_KEY should be injected from secret storage; preserve PEM newlines or use \n escapes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Phase 2 — private S3-compatible object storage
# Required for Rider documents, delivery proof and incident evidence in durable environments.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_MAX_UPLOAD_BYTES=10485760

# Rider Android build-time public API origin. Do not include secrets.
# Example emulator local API: http://10.0.2.2:3000
# Production example: https://api.deetoo.co.ke
EXPO_PUBLIC_API_BASE_URL=
